pipeline {

    agent any

    triggers {
        githubPush()
    }

    environment {

        DOCKER_PATH = "/usr/local/bin/docker"

        DOCKER_IMAGE = "mad0008271/graphene-device-architecture:latest"

        CONTAINER_NAME = "graphene-app"

        DOCKER_BUILDKIT = "0"

        MONGO_URI = "mongodb+srv://mad0008271_db_user:Ckx0s6z9tWAGmCUz@graphene-device-archite.rvxncn2.mongodb.net/graphene?retryWrites=true&w=majority"

        PORT = "5001"
    }

    stages {

        stage('GitHub Trigger Check') {

            steps {

                echo 'GitHub webhook triggered Jenkins pipeline'
            }
        }

        stage('Check Workspace') {

            steps {

                sh 'pwd'

                sh 'ls -la'
            }
        }

        stage('Check Docker Version') {

            steps {

                sh '$DOCKER_PATH --version'

                sh '$DOCKER_PATH compose version'
            }
        }

        stage('Docker Automation Cleanup') {

            steps {

                sh '''
                $DOCKER_PATH image prune -af || true
                '''
            }
        }

        stage('MongoDB Connection Check') {

            steps {

                sh '''
                echo "MongoDB URI Configured Successfully"
                '''
            }
        }

        stage('Docker Build Image') {

            steps {

                sh '''

                export DOCKER_BUILDKIT=0

                $DOCKER_PATH build \
                --no-cache \
                -t $DOCKER_IMAGE \
                ./backend

                '''
            }
        }

        stage('Check Docker Images') {

            steps {

                sh '''
                $DOCKER_PATH images
                '''
            }
        }

        stage('Docker Login') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh '''

                    mkdir -p ~/.docker

                    echo '{
                      "auths": {}
                    }' > ~/.docker/config.json

                    echo $DOCKER_PASS | \
                    $DOCKER_PATH login \
                    -u $DOCKER_USER \
                    --password-stdin

                    '''
                }
            }
        }

        stage('Docker Push Automation') {

            steps {

                sh '''
                $DOCKER_PATH push $DOCKER_IMAGE
                '''
            }
        }

        stage('Docker Pull Automation') {

            steps {

                sh '''
                $DOCKER_PATH pull $DOCKER_IMAGE
                '''
            }
        }

        stage('Stop Old Container') {

            steps {

                sh '''
                $DOCKER_PATH rm -f $CONTAINER_NAME || true
                '''
            }
        }

        stage('Run Docker Container') {

            steps {

                sh '''

                $DOCKER_PATH run -d \
                --restart unless-stopped \
                --name $CONTAINER_NAME \
                -e MONGO_URI="$MONGO_URI" \
                -e PORT="$PORT" \
                -p 5001:5000 \
                $DOCKER_IMAGE

                '''
            }
        }

        stage('Docker Trigger Automation') {

            steps {

                sh '''
                $DOCKER_PATH ps -a
                '''
            }
        }

        stage('Docker Logs') {

            steps {

                sh '''
                $DOCKER_PATH logs $CONTAINER_NAME
                '''
            }
        }

        stage('Docker Copy Backup') {

            steps {

                sh '''

                mkdir -p backup

                $DOCKER_PATH cp \
                $CONTAINER_NAME:/app \
                backup/

                '''
            }
        }

        stage('Docker Error Finder') {

            steps {

                sh '''
                $DOCKER_PATH inspect $CONTAINER_NAME
                '''
            }
        }

        stage('Docker Compose Validation') {

            steps {

                sh '''
                $DOCKER_PATH compose config
                '''
            }
        }

        stage('Render Deployment Ready') {

            steps {

                echo 'Application is ready for Render deployment'
            }
        }
    }

    post {

        success {

            echo 'CI/CD Pipeline Completed Successfully'
        }

        failure {

            echo 'Pipeline Failed'
        }

        always {

            sh '''
            $DOCKER_PATH ps -a || true
            '''
        }
    }
}