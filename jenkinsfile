pipeline {

    agent any

    environment {

        DOCKER_IMAGE = "mad0008271/graphene-device-architecture:latest"

        CONTAINER_NAME = "graphene-app"

        DOCKER_PATH = "/usr/local/bin/docker"

        DOCKER_BUILDKIT = "0"

        AZURE_WEBAPP_NAME = "graphene-device-app"

        AZURE_RESOURCE_GROUP = "graphene-group"
    }

    stages {

        stage('Check Workspace') {

            steps {

                sh 'pwd'

                sh 'ls -la'
            }
        }

        stage('Check Docker Version') {

            steps {

                sh '$DOCKER_PATH --version'

                sh '$DOCKER_PATH compose version || true'
            }
        }

        stage('Docker Cleanup') {

            steps {

                sh '''
                $DOCKER_PATH rm -f $CONTAINER_NAME || true

                $DOCKER_PATH system prune -af || true
                '''
            }
        }

        stage('Docker Build') {

            steps {

                sh '''
                export DOCKER_BUILDKIT=0

                $DOCKER_PATH build \
                --no-cache \
                -t $DOCKER_IMAGE \
                ./backend
                '''
            }
        }

        stage('Check Docker Images') {

            steps {

                sh '''
                $DOCKER_PATH images
                '''
            }
        }

        stage('Docker Login') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh '''
                    echo $DOCKER_PASS | \
                    $DOCKER_PATH login \
                    -u $DOCKER_USER \
                    --password-stdin
                    '''
                }
            }
        }

        stage('Docker Push') {

            steps {

                sh '''
                $DOCKER_PATH push $DOCKER_IMAGE
                '''
            }
        }

        stage('Docker Pull') {

            steps {

                sh '''
                $DOCKER_PATH pull $DOCKER_IMAGE
                '''
            }
        }

        stage('Run Docker Container') {

            steps {

                sh '''
                $DOCKER_PATH rm -f $CONTAINER_NAME || true

                $DOCKER_PATH run -d \
                --restart unless-stopped \
                --name $CONTAINER_NAME \
                -p 5002:5000 \
                $DOCKER_IMAGE
                '''
            }
        }

        stage('Docker Container Status') {

            steps {

                sh '''
                $DOCKER_PATH ps -a
                '''
            }
        }

        stage('Docker Logs') {

            steps {

                sh '''
                $DOCKER_PATH logs $CONTAINER_NAME || true
                '''
            }
        }

        stage('Docker Copy Backup') {

            steps {

                sh '''
                mkdir -p backup || true

                $DOCKER_PATH cp \
                $CONTAINER_NAME:/app \
                backup/ || true
                '''
            }
        }

        stage('Docker Error Finder') {

            steps {

                sh '''
                $DOCKER_PATH inspect $CONTAINER_NAME || true
                '''
            }
        }

        stage('Docker Compose Validation') {

            steps {

                sh '''
                $DOCKER_PATH compose config || true
                '''
            }
        }

        stage('Azure Configure Container') {

            steps {

                sh '''
                az webapp config container set \
                --name $AZURE_WEBAPP_NAME \
                --resource-group $AZURE_RESOURCE_GROUP \
                --docker-custom-image-name $DOCKER_IMAGE
                '''
            }
        }

        stage('Azure App Settings') {

            steps {

                sh '''
                az webapp config appsettings set \
                --name $AZURE_WEBAPP_NAME \
                --resource-group $AZURE_RESOURCE_GROUP \
                --settings WEBSITES_PORT=5000
                '''
            }
        }

        stage('Azure Restart WebApp') {

            steps {

                sh '''
                az webapp restart \
                --name $AZURE_WEBAPP_NAME \
                --resource-group $AZURE_RESOURCE_GROUP
                '''

                sleep 60
            }
        }

        stage('Azure Container Verification') {

            steps {

                sh '''
                az webapp config container show \
                --name $AZURE_WEBAPP_NAME \
                --resource-group $AZURE_RESOURCE_GROUP
                '''
            }
        }

        stage('Azure Health Check') {

            steps {

                sh '''
                curl -I https://graphene-device-app.azurewebsites.net || true
                '''
            }
        }

        stage('Render Deployment Ready') {

            steps {

                echo 'Application ready for Render deployment'
            }
        }
    }

    post {

        success {

            echo 'CI/CD Pipeline Completed Successfully'
        }

        failure {

            echo 'Pipeline Failed'
        }

        always {

            sh '''
            $DOCKER_PATH ps -a || true
            '''
        }
    }
}