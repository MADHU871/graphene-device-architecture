pipeline {
    agent any

    environment {
        DOCKER_PATH = "/opt/homebrew/bin/docker"
        DOCKER_IMAGE = "madhu871/graphene-device-architecture"
        CONTAINER_NAME = "graphene-app"
    }

    stages {

        stage('Check Workspace') {
            steps {
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Check Docker Version') {
            steps {
                sh '$DOCKER_PATH --version'
                sh '$DOCKER_PATH compose version'
            }
        }

        stage('Docker Build Image') {
            steps {
                sh '''
                $DOCKER_PATH build -t $DOCKER_IMAGE ./backend
                '''
            }
        }

        stage('Check Docker Images') {
            steps {
                sh '''
                $DOCKER_PATH images
                '''
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {

                    sh '''
                    echo $DOCKER_PASS | $DOCKER_PATH login -u $DOCKER_USER --password-stdin
                    '''
                }
            }
        }

        stage('Docker Push') {
            steps {
                sh '''
                $DOCKER_PATH push $DOCKER_IMAGE
                '''
            }
        }

        stage('Docker Pull') {
            steps {
                sh '''
                $DOCKER_PATH pull $DOCKER_IMAGE
                '''
            }
        }

        stage('Stop Old Container') {
            steps {
                sh '''
                $DOCKER_PATH rm -f $CONTAINER_NAME || true
                '''
            }
        }

        stage('Run Docker Container') {
            steps {
                sh '''
                $DOCKER_PATH run -d \
                --name $CONTAINER_NAME \
                -p 5000:5000 \
                $DOCKER_IMAGE
                '''
            }
        }

        stage('Docker Container Status') {
            steps {
                sh '''
                $DOCKER_PATH ps -a
                '''
            }
        }

        stage('Docker Logs') {
            steps {
                sh '''
                $DOCKER_PATH logs $CONTAINER_NAME
                '''
            }
        }

        stage('Docker Copy Backup') {
            steps {
                sh '''
                mkdir -p backup

                $DOCKER_PATH cp \
                $CONTAINER_NAME:/app \
                backup/
                '''
            }
        }

        stage('Docker Error Finder') {
            steps {
                sh '''
                $DOCKER_PATH inspect $CONTAINER_NAME
                '''
            }
        }

        stage('Docker Compose Validation') {
            steps {
                sh '''
                $DOCKER_PATH compose config
                '''
            }
        }

        stage('Render Deployment Ready') {
            steps {
                echo 'Application is ready for deployment on Render'
            }
        }
    }

    post {

        success {
            echo 'CI/CD Pipeline Completed Successfully'
        }

        failure {
            echo 'Pipeline Failed'
        }

        always {
            sh '''
            $DOCKER_PATH ps -a || true
            '''
        }
    }
}